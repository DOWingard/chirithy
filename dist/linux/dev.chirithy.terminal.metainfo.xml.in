<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPID@</id>
  <launchable type="desktop-id">@APPID@.desktop</launchable>
  <name>@NAME@</name>
  <url type="homepage">https://ghostty.org</url>
  <url type="help">https://ghostty.org/docs</url>
  <url type="vcs-browser">https://github.com/ghostty-org/ghostty</url>
  <summary>A Chirithy-themed build of the Ghostty terminal emulator</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <content_rating type="oars-1.1" />
  <description>
    <p>
      Chirithy is a themed build of the Ghostty terminal emulator. It keeps
      Ghostty's speed, features, and native UI, and adds Spirit and Nightmare
      color modes and a companion that reacts to what the shell is doing.
    </p>
  </description>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <!--
      Mobile/tablet AND desktop supported

      Ref: https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines#display-size
    -->
    <display_length compare="ge">360</display_length>
  </requires>
  <translation type="gettext">dev.chirithy.terminal</translation>

  <!--
    TODO: Generate manifest location data.

    Ref: https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines#manifest-location

  <custom>
    <value key="flathub::manifest">https://github.com/ghostty-org/ghostty/blob/<hash>/flatpak/dev.chirithy.terminal.yml</value>
  </custom>
  -->

  <releases>
    <!-- TODO: Generate this automatically -->
    <release version="1.4.0" date="2026-10-27">
        <url type="details">https://ghostty.org/docs/install/release-notes/1-4-0</url>
    </release>
    <release version="1.3.1" date="2026-03-13">
        <url type="details">https://ghostty.org/docs/install/release-notes/1-3-1</url>
    </release>
    <release version="1.3.0" date="2026-03-09">
        <url type="details">https://ghostty.org/docs/install/release-notes/1-3-0</url>
    </release>
    <release version="1.0.1" date="2024-12-31">
        <url type="details">https://ghostty.org/docs/install/release-notes/1-0-1</url>
    </release>
  </releases>
</component>
